-- EXPERIMENT : 10
-- Aim: To generate a dataset containing exactly 10,000 rows,
-- identify five slow queries, analyze their execution plans using EXPLAIN,
-- optimize them using indexing and query rewriting, and compare query
-- execution before and after optimization.


-- 1. Create Dataset Table

CREATE TABLE Sales_Data (
    sale_id INT PRIMARY KEY,
    customer_id INT,
    product_id INT,
    region VARCHAR(30),
    quantity INT,
    amount DECIMAL(10,2),
    sale_date DATE
);


-- 2. Generate Exactly 10,000 Rows

INSERT INTO Sales_Data
(sale_id, customer_id, product_id, region, quantity, amount, sale_date)
SELECT
    n,
    MOD(n, 1000) + 1,
    MOD(n, 100) + 1,
    CASE MOD(n, 4)
        WHEN 0 THEN 'North'
        WHEN 1 THEN 'South'
        WHEN 2 THEN 'East'
        ELSE 'West'
    END,
    MOD(n, 10) + 1,
    (MOD(n, 10) + 1) * 500,
    DATE_ADD('2026-01-01', INTERVAL MOD(n, 365) DAY)
FROM (
    SELECT a.n + b.n * 10 + c.n * 100 + d.n * 1000 + 1 AS n
    FROM
        (SELECT 0 n UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL
         SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL
         SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9) a,
        (SELECT 0 n UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL
         SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL
         SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9) b,
        (SELECT 0 n UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL
         SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL
         SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9) c,
        (SELECT 0 n UNION ALL SELECT 1 UNION ALL SELECT 2 UNION ALL
         SELECT 3 UNION ALL SELECT 4 UNION ALL SELECT 5 UNION ALL
         SELECT 6 UNION ALL SELECT 7 UNION ALL SELECT 8 UNION ALL SELECT 9) d
) numbers
WHERE n <= 10000;


-- SQL QUERIES


-- SLOW QUERY 1: CUSTOMER SEARCH

SELECT *
FROM Sales_Data
WHERE customer_id = 500;


-- Analyze Query 1

EXPLAIN
SELECT *
FROM Sales_Data
WHERE customer_id = 500;


-- Optimize Query 1

CREATE INDEX idx_customer
ON Sales_Data(customer_id);

EXPLAIN
SELECT *
FROM Sales_Data
WHERE customer_id = 500;


-- SLOW QUERY 2: REGION AND DATE SEARCH

SELECT *
FROM Sales_Data
WHERE region = 'North'
AND sale_date = '2026-03-01';


-- Analyze Query 2

EXPLAIN
SELECT *
FROM Sales_Data
WHERE region = 'North'
AND sale_date = '2026-03-01';


-- Optimize Query 2

CREATE INDEX idx_region_date
ON Sales_Data(region, sale_date);

EXPLAIN
SELECT *
FROM Sales_Data
WHERE region = 'North'
AND sale_date = '2026-03-01';


-- SLOW QUERY 3: PRODUCT SEARCH

SELECT *
FROM Sales_Data
WHERE product_id = 50;


-- Analyze Query 3

EXPLAIN
SELECT *
FROM Sales_Data
WHERE product_id = 50;


-- Optimize Query 3

CREATE INDEX idx_product
ON Sales_Data(product_id);

EXPLAIN
SELECT *
FROM Sales_Data
WHERE product_id = 50;


-- SLOW QUERY 4: DATE RANGE SEARCH

SELECT *
FROM Sales_Data
WHERE sale_date BETWEEN '2026-01-01' AND '2026-06-30';


-- Analyze Query 4

EXPLAIN
SELECT *
FROM Sales_Data
WHERE sale_date BETWEEN '2026-01-01' AND '2026-06-30';


-- Optimize Query 4

CREATE INDEX idx_sale_date
ON Sales_Data(sale_date);

EXPLAIN
SELECT *
FROM Sales_Data
WHERE sale_date BETWEEN '2026-01-01' AND '2026-06-30';


-- SLOW QUERY 5: QUERY REWRITING

SELECT *
FROM Sales_Data
WHERE quantity + 1 > 5;


-- Analyze Query 5

EXPLAIN
SELECT *
FROM Sales_Data
WHERE quantity + 1 > 5;


-- OPTIMIZED QUERY

-- Rewrite the condition so that the column
-- does not need to be calculated for every row.

SELECT *
FROM Sales_Data
WHERE quantity > 4;


-- Analyze Optimized Query

EXPLAIN
SELECT *
FROM Sales_Data
WHERE quantity > 4;


