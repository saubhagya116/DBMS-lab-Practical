-- 3. Functional Dependencies

-- customer_id -> customer_name, customer_city
-- product_id -> product_name, price
-- salesperson_id -> salesperson_name
-- order_id -> order_date, customer_id, salesperson_id
-- (order_id, product_id) -> quantity

-- Composite Key: (order_id, product_id)


-- 4. Convert UNF to 1NF

CREATE TABLE Sales_1NF (
    order_id INT,
    order_date DATE,
    customer_id INT,
    customer_name VARCHAR(50),
    customer_city VARCHAR(50),
    product_id INT,
    product_name VARCHAR(50),
    quantity INT,
    price DECIMAL(10,2),
    salesperson_id INT,
    salesperson_name VARCHAR(50),
    PRIMARY KEY (order_id, product_id)
);


-- 5. Convert 1NF to 2NF

CREATE TABLE Orders_2NF (
    order_id INT PRIMARY KEY,
    order_date DATE,
    customer_id INT,
    customer_name VARCHAR(50),
    customer_city VARCHAR(50),
    salesperson_id INT,
    salesperson_name VARCHAR(50)
);

CREATE TABLE Products_2NF (
    product_id INT PRIMARY KEY,
    product_name VARCHAR(50),
    price DECIMAL(10,2)
);

CREATE TABLE Order_Details_2NF (
    order_id INT,
    product_id INT,
    quantity INT,
    PRIMARY KEY (order_id, product_id)
);


-- 6. Convert 2NF to 3NF

CREATE TABLE Customers (
    customer_id INT PRIMARY KEY,
    customer_name VARCHAR(50),
    customer_city VARCHAR(50)
);

CREATE TABLE Salespersons (
    salesperson_id INT PRIMARY KEY,
    salesperson_name VARCHAR(50)
);

CREATE TABLE Orders (
    order_id INT PRIMARY KEY,
    order_date DATE,
    customer_id INT,
    salesperson_id INT,
    FOREIGN KEY (customer_id) REFERENCES Customers(customer_id),
    FOREIGN KEY (salesperson_id) REFERENCES Salespersons(salesperson_id)
);

CREATE TABLE Products (
    product_id INT PRIMARY KEY,
    product_name VARCHAR(50),
    price DECIMAL(10,2)
);

CREATE TABLE Order_Details (
    order_id INT,
    product_id INT,
    quantity INT,
    PRIMARY KEY (order_id, product_id),
    FOREIGN KEY (order_id) REFERENCES Orders(order_id),
    FOREIGN KEY (product_id) REFERENCES Products(product_id)
);


-- 7. BCNF Verification

-- customer_id -> customer_name, customer_city
-- product_id -> product_name, price
-- salesperson_id -> salesperson_name
-- order_id -> order_date, customer_id, salesperson_id
-- (order_id, product_id) -> quantity

-- All determinants in the final relations are candidate keys.
-- Therefore, the decomposed relations satisfy BCNF
-- for the given functional dependencies.


-- SQL QUERIES


-- 1. Test Customer Dependency

SELECT customer_id, COUNT(DISTINCT customer_name) AS names
FROM Customers
GROUP BY customer_id;


-- 2. Test Product Dependency

SELECT product_id, COUNT(DISTINCT price) AS prices
FROM Products
GROUP BY product_id;


-- 3. Lossless Join Verification

SELECT o.order_id, c.customer_name, p.product_name, od.quantity
FROM Orders o
JOIN Customers c
ON o.customer_id = c.customer_id
JOIN Order_Details od
ON o.order_id = od.order_id
JOIN Products p
ON od.product_id = p.product_id;


-- 4. Dependency Preservation Check

SELECT o.order_id, o.customer_id, c.customer_name
FROM Orders o
JOIN Customers c
ON o.customer_id = c.customer_id;
