-- EXPERIMENT : 7
-- Aim: To identify functional dependencies in a denormalized Sales table
-- and normalize the relation step-by-step from UNF to 3NF and BCNF.
-- The decomposition is also examined for lossless join and
-- dependency preservation using SQL queries.


-- 1. Create UNF Sales Table

CREATE TABLE Sales_UNF (
    order_id INT,
    order_date DATE,
    customer_id INT,
    customer_name VARCHAR(50),
    customer_city VARCHAR(50),
    product_id INT,
    product_name VARCHAR(50),
    quantity INT,
    price DECIMAL(10,2),
    salesperson_id INT,
    salesperson_name VARCHAR(50)
);


