-- EXPERIMENT : 8
-- Aim: To implement banking-style transactions using BEGIN, COMMIT,
-- ROLLBACK, and SAVEPOINT, simulate partial failures, and demonstrate
-- isolation levels and concurrency anomalies using two database sessions.


-- 1. Create Bank Account Table

CREATE TABLE Bank_Account (
    account_id INT PRIMARY KEY,
    account_holder VARCHAR(50),
    balance DECIMAL(10,2)
);


-- 2. Insert Accounts

INSERT INTO Bank_Account VALUES
(1, 'Rohit', 50000),
(2, 'Aman', 30000),
(3, 'Neha', 40000);


-- SQL QUERIES


-- 1. BEGIN and COMMIT

START TRANSACTION;

UPDATE Bank_Account
SET balance = balance - 5000
WHERE account_id = 1;

UPDATE Bank_Account
SET balance = balance + 5000
WHERE account_id = 2;

COMMIT;


-- 2. ROLLBACK

START TRANSACTION;

UPDATE Bank_Account
SET balance = balance - 10000
WHERE account_id = 1;

ROLLBACK;


-- 3. SAVEPOINT

START TRANSACTION;

UPDATE Bank_Account
SET balance = balance - 5000
WHERE account_id = 1;

SAVEPOINT transfer_point;

UPDATE Bank_Account
SET balance = balance + 5000
WHERE account_id = 2;

ROLLBACK TO transfer_point;

COMMIT;


-- 4. Simulate Partial Failure

START TRANSACTION;

UPDATE Bank_Account
SET balance = balance - 5000
WHERE account_id = 1;

SAVEPOINT before_second_update;

UPDATE Bank_Account
SET balance = balance + 5000
WHERE account_id = 2;

ROLLBACK TO before_second_update;

COMMIT;


-- 5. Set Isolation Level

SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;


-- 6. Check Isolation Level

SELECT @@transaction_isolation;


-- TWO-SESSION CONCURRENCY TEST
-- Open two MySQL Workbench query tabs/connections.


-- SESSION 1

START TRANSACTION;

UPDATE Bank_Account
SET balance = balance - 5000
WHERE account_id = 1;

SELECT *
FROM Bank_Account
WHERE account_id = 1;

-- Do not commit yet.


-- SESSION 2

START TRANSACTION;

SELECT *
FROM Bank_Account
WHERE account_id = 1;

COMMIT;


-- SESSION 1

COMMIT;


-- NON-REPEATABLE READ DEMONSTRATION
-- Set both sessions to READ COMMITTED.


-- SESSION 1

SET SESSION TRANSACTION ISOLATION LEVEL READ COMMITTED;

START TRANSACTION;

SELECT balance
FROM Bank_Account
WHERE account_id = 1;


-- SESSION 2

START TRANSACTION;

UPDATE Bank_Account
SET balance = balance + 5000
WHERE account_id = 1;

COMMIT;


-- SESSION 1

SELECT balance
FROM Bank_Account
WHERE account_id = 1;

COMMIT;

-- The second read can return a different value because
-- another transaction committed a change.
